GUID":-4729468408257909362,"m_classType":"CompareValueConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"javascriptEngine":"JetPack JavascriptEngine","scriptText":"function escapeVCard(str) {\n    if (!str) return \"\";\nreturn str;\n    return String(str)\n        .replace(/\\\\/g, \"\\\\\\\\\")\n        .replace(/;/g, \"\\\\;\")\n        .replace(/,/g, \"\\\\,\")\n        .replace(/\\r\\n|\\r|\\n/g, \"\\\\n\");\n}\n\nfunction qpEncode(str) {\n    if (!str) return \"\";\n\n    const utf8 \u003d unescape(encodeURIComponent(str));\n    let out \u003d \"\";\n\n    for (let i \u003d 0; i \u003c utf8.length; i++) {\n        const c \u003d utf8.charCodeAt(i);\n\n        if (c \u003e\u003d 128) {\n            out +\u003d \"\u003d\" + c.toString(16).toUpperCase().padStart(2, \"0\");\n        } else if (c \u003d\u003d\u003d 32) {\n            out +\u003d \"\u003d20\";\n        } else {\n            out +\u003d String.fromCharCode(c);\n        }\n    }\n\n    return out;\n}\nfunction createVCard(contact) {\n    const lines \u003d [\n        \"BEGIN:VCARD\",\n        \"VERSION:3.0\",\n\n        \"N;CHARSET\u003dUTF-8;ENCODING\u003dQUOTED-PRINTABLE:\" +\n        qpEncode(escapeVCard(contact.fullName)) + \";;;;\",\n\n        \"FN;CHARSET\u003dUTF-8;ENCODING\u003dQUOTED-PRINTABLE:\" +\n        qpEncode(escapeVCard(contact.fullName)),\n\n        contact.phone\n            ? \"TEL;TYPE\u003dCELL,VOICE:\" + contact.phone\n            : \"\",\n\n        contact.email\n            ? \"EMAIL:\" + contact.email\n            : \"\",\n\n        contact.company\n            ? \"ORG;CHARSET\u003dUTF-8;ENCODING\u003dQUOTED-PRINTABLE:\" +\n              qpEncode(escapeVCard(contact.company))\n            : \"\",\n\n        contact.job\n            ? \"TITLE;CHARSET\u003dUTF-8;ENCODING\u003dQUOTED-PRINTABLE:\" +\n              qpEncode(escapeVCard(contact.job))\n            : \"\",\n\n        \"END:VCARD\"\n    ];\n\n    return lines.filter(Boolean).join(\"\\r\\n\");\n}\n\nconst vcard \u003d createVCard({\n    fullName: \"{lv\u003dcontactsDict[{iterator_dictionary_key}][fullname]}\",\n    phone: \"{lv\u003dcontactsDict[{iterator_dictionary_key}][value]}\",\n    email: \"{lv\u003dcontactsDict[{iterator_dictionary_key}][email]}\",\n    company: \"{lv\u003dcontactsDict[{iterator_dictionary_key}][organization_name]}\",\n    job: \"{lv\u003dcontactsDict[{iterator_dictionary_key}][organization_position]}\"\n});\n\n//console.log(vcard);\nmdOutput(vcard);","stringVariableName":"tempStr","disableLogging":false,"m_SIGUID":-5151856058871866781,"m_classType":"JavaScriptAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"dontLogIfConditionIsFalse":false,"disableLogging":false,"m_SIGUID":-6027378498546633031,"m_classType":"ElseAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"booleanDictionaryKeys":{"keys":[]},"dictionaryKeys":[],"dictionaryOrArrayType":-1,"existingManualKeyType":0,"m_booleanInvert":false,"m_darkMode":-1,"m_doubleRandomMax":0.0,"m_doubleRandomMin":0.0,"m_falseLabel":"Ложь","m_intExpression":false,"m_intRandom":false,"m_intRandomMax":0,"m_intRandomMin":0,"m_intValueDecrement":false,"m_intValueIncrement":false,"m_newBooleanValue":false,"m_newDoubleValue":0.0,"m_newIntValue":0,"m_newStringValue":"{lv\u003dcontacts[{iterator_dictionary_key}][uri]}{lv\u003dcontacts[{iterator_dictionary_key}][value]}","m_trueLabel":"Истина","m_userPrompt":false,"m_userPromptEmptyAtStart":false,"m_userPromptPassword":false,"m_userPromptPasswordToggle":false,"m_userPromptShowCancel":true,"m_userPromptStopAfterCancel":true,"m_variable":{"description":"System: Temp variable","dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":true,"isLocalVar":true,"isSecure":true,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_n