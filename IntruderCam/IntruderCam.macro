ion","m_comment":"Creating a subfolder for the current event","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_delayInMilliSeconds":500,"m_delayInSeconds":0,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-5485521691059922616,"m_classType":"PauseAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"color":-1,"separatorLabel":"","disableLogging":false,"m_SIGUID":-6823538455417203368,"m_classType":"SeparatorAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"allFilesPath":"{lv\u003dpathToFiles}/{lv\u003dlastDateTime}","applyAutoFocus":false,"customFilename":"{lv\u003dlastDateTime}_front","m_flashOption":0,"m_showIcon":false,"m_useFrontCamera":true,"pathName":"primary:MacroDroid/IntruderCam","pathUri":"content://com.android.externalstorage.documents/tree/primary%3AMacroDroid%2FIntruderCam","useAllFilesAccess":true,"disableLogging":false,"m_SIGUID":-8553264332285210223,"m_classType":"TakePictureAction","m_comment":"Default path: /sdcard/MacroDroid/IntruderCam/{subfolder}","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_delayInMilliSeconds":0,"m_delayInSeconds":5,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-4656335925063280147,"m_classType":"PauseAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"allFilesPath":"{lv\u003dpathToFiles}/{lv\u003dlastDateTime}","applyAutoFocus":false,"customFilename":"{lv\u003dlastDateTime}_back","m_flashOption":0,"m_showIcon":false,"m_useFrontCamera":false,"pathName":"primary:MacroDroid/IntruderCam","pathUri":"content://com.android.externalstorage.documents/tree/primary%3AMacroDroid%2FIntruderCam","useAllFilesAccess":true,"disableLogging":false,"m_SIGUID":-7675585541145217538,"m_classType":"TakePictureAction","m_comment":"Default path: /sdcard/MacroDroid/IntruderCam/{subfolder}","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"color":-1,"separatorLabel":"","disableLogging":false,"m_SIGUID":-8147673304279716734,"m_classType":"SeparatorAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_state":1,"disableLogging":false,"m_SIGUID":-8054493386749654168,"m_classType":"SetLocationModeAction","m_comment":"","m_constraintList":[],"m_isDisabled":true,"m_isOrCondition":false},{"childrenCollapsed":true,"dontLogIfConditionIsFalse":false,"disableLogging":false,"m_SIGUID":-4869803327791719588,"m_classType":"IfConditionAction","m_comment":"","m_constraintList":[{"m_enabled":true,"disableLogging":false,"m_SIGUID":-5434861554563743242,"m_classType":"GPSEnabledConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false},{"booleanDictionaryKeys":{"keys":[]},"dictionaryKeys":[],"dictionaryOrArrayType":-1,"existingManualKeyType":0,"m_booleanInvert":false,"m_darkMode":-1,"m_doubleRandomMax":0.0,"m_doubleRandomMin":0.0,"m_falseLabel":"Ложь","m_intExpression":false,"m_intRandom":false,"m_intRandomMax":0,"m_intRandomMin":0,"m_intValueDecrement":false,"m_intValueIncrement":false,"m_newBooleanValue":false,"m_newDoubleValue":0.0,"m_newIntValue":0,"m_newStringValue":"\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\"{lv\u003dcurrentLang}\"\u003e\n\u003chead\u003e\n\u003cmeta charset\u003d\"UTF-8\"\u003e\n\u003cmeta name\u003d\"viewport\" content\u003d\"width\u003ddevice-width, initial-scale\u003d1.0\"\u003e\n\u003ctitle\u003eIntruderCam📍{lv\u003dlangs[{lv\u003dcurrentLang}][Coordinates of violation]}\u003c/title\u003e\n\n\u003cstyle\u003e\nhtml,body{\nmargin:0;\npadding:0;\nheight:100%;\nbackground:#f0f0f0;\nfont-family:sans-serif;\ndisplay:flex;\nflex-direction:column;\nalign-items:center;\njustify-content:center;\n}\nbody{padding:10px;box-sizing:border-box;}\n#map{\nwidth:100%;\nheight:80%;\nborder-radius:10px;\nbox-shadow:0 2px 6px rgba(0,0,0,.2);\n}\n#info{margin-bottom:10px;font-size:14px;color:#333;}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n\u003ch3\u003e🗺️ IntruderCam - {lv\u003dlangs[{lv\u003dcurrentLang}][Location of the violation]}\u003c/h3\u003e\n\n\u003cdiv id\u003d\"info\"\u003e\u003c/div\u003e\n\u003cdiv id\u003d\"map\"\u003e\u003c/div\u003e\n\u003cdiv id\u003d\"photos\"\u003e\u003c/div\u003e\n\n\u003cscript\u003e\nconst OL_CDNS\u003d[\n{\ncss:\"https://cdn.jsdelivr.net/npm/ol@9.1.0/ol.css\",\njs:\"https://cdn.jsdelivr.net/npm/ol@9.1.0/dist/ol.js\"\n},\n{\ncss:\"https://unpkg.com/ol@9.1.0/ol.css\",\njs:\"https://unpkg.com/ol@9.1.0/dist/ol.js\"\n},\n{\ncss:\"https://cdnjs.cloudflare.com/ajax/libs/ol3/4.6.5/ol.css\",\njs:\"https://cdnjs.cloudflare.com/ajax/libs/ol3/4.6.5/ol.js\"\n}\n];\n\nfunction loadCSS(url){\nreturn new Promise((resolve,reject)\u003d\u003e{\nconst l\u003ddocument.createElement(\"link\");\nl.rel\u003d\"stylesheet\";\nl.href\u003durl;\nl.onload\u003dresolve;\nl.onerror\u003dreject;\ndocument.head.appendChild(l);\n});\n}\n\nfunction loadJS(url){\nreturn new Promise((resolve,reject)\u003d\u003e{\nconst s\u003ddocument.createElement(\"script\");\ns.src\u003durl;\ns.onload\u003dresolve;\ns.onerror\u003dreject;\ndocument.head.appendChild(s);\n});\n}\n\nasync function loadOpenLayers(){\nfor(const cdn of OL_CDNS){\ntry{\nawait loadCSS(cdn.css);\nawait loadJS(cdn.js);\nif(window.ol)return;\n}catch(e){\nconsole.warn(\"CDN failed:\",cdn.js);\n}\n}\nthrow new Error(\"No CDN available\");\n}\n\nfunction initMap(){\n\nconst gpsData\u003d{\nlat:{last_loc_lat},\nlon:{last_loc_long},\ntime:\u0027{year}-{month_digit}-{dayofmonth} {hour_0}:{minute}:{second}\u0027\n};\n\nif(isNaN(gpsData.lat)||isNaN(gpsData.lon)){\ndocument.getElementById(\"map\").innerHTML\u003d\n\u0027\u003cdiv style\u003d\"text-align:center;color:#666;margin-top:40%\"\u003eThere is no coordinate data\u003c/div\u003e\u0027;\nreturn;\n}\n\ndocument.getElementById(\"info\").textContent\u003d\n`⏱ ${gpsData.time} | 📍 ${gpsData.lat.toFixed(5)}, ${gpsData.lon.toFixed(5)}`;\n\nconst map\u003dnew ol.Map({\ntarget:\"map\",\nlayers:[\nnew ol.layer.Tile({\nsource:new ol.source.XYZ({\nurl:\"https://tile.openstreetmap.org/{z}/{x}/{y}.png\",\nattributions:\"© OpenStreetMap contributors\"\n})\n})\n],\nview:new ol.View({\ncenter:ol.proj.fromLonLat([gpsData.lon,gpsData.lat]),\nzoom:15\n})\n});\n\nconst feature\u003dnew ol.Feature({\ngeometry:new ol.geom.Point(\nol.proj.fromLonLat([gpsData.lon,gpsData.lat])\n)\n});\n\nconst vectorSource\u003dnew ol.source.Vector({\nfeatures:[feature]\n});\n\nconst vectorLayer\u003dnew ol.layer.Vector({\nsource:vectorSource,\nstyle:new ol.style.Style({\nimage:new ol.style.Circle({\nradius:6,\nfill:new ol.style.Fill({color:\"#007bff\"}),\nstroke:new ol.style.Stroke({\ncolor:\"#fff\",\nwidth:2\n})\n})\n})\n});\n\nmap.addLayer(vectorLayer);\n}\n\n(async()\u003d\u003e{\ntry{\nawait loadOpenLayers();\ninitMap();\n}catch(e){\nconsole.error(e);\ndocument.getElementById(\"map\").innerHTML\u003d\n\u0027\u003cdiv style\u003d\"text-align:center;color:red;margin-top:40%\"\u003eUnable to load OpenLayers from any CDN.\u003c/div\u003e\u0027;\n}\n})();\n\u003c/script\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e","m_trueLabel":"Истина","m_userPrompt":false,"m_userPromptEmptyAtStart":false,"m_userPromptPassword":false,"m_userPromptPasswordToggle":false,"m_userPromptShowCancel":true,"m_userPromptStopAfterCancel":true,"m_variable":{"description":"System: Generated HTML coordinate viewing template","dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":true,"isLocalVar":true,"isSecure":true,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"gpsCoordinatesViewer","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"disableLogging":false,"m_SIGUID":-5315191837648604863,"m_classType":"SetVariableAction","m_comment":"Forming an HTML GPS viewing template","m_constraintList":[],"m_isDisabled":false,"m_isOrConditio